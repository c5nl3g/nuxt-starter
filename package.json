{
  "name": "nuxt-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "deps:check": "pnpm dlx taze --maturity-period=1 --include-locked -r",
    "dev": "nuxt dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "nuxt generate",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "preview": "nuxt preview",
    "reset": "pnpm dlx rimraf -g '**/node_modules' '**/.nuxt' '**/pnpm-lock.yaml'"
  },
  "dependencies": {
    "nuxt": "catalog:prod"
  },
  "devDependencies": {
    "husky": "catalog:hooks",
    "lint-staged": "catalog:hooks",
    "oxfmt": "catalog:fmt",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "typescript": "catalog:dev"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --type-aware --type-check --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
